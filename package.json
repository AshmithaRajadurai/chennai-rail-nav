{
  "name": "chennai-railway-navigation-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix server install && npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/server.js",
    "server:start": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  }
}
